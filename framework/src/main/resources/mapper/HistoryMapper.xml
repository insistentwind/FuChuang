<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.ning.mapper.HistoryMapper">


    <select id="getListByUserId" resultType="com.ning.domain.vo.WorkVo">
        SELECT work.*
        FROM history
        LEFT JOIN work ON work.id=history.work_id
        where history.user_id = #{id}
    </select>
</mapper>
