<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.ning.mapper.ResumeMapper">

    <select id="getInfoByUserId" resultType="com.ning.domain.vo.ResumeVo">
        SELECT *
        FROM `resume` r
                 LEFT JOIN user_resume ur on r.id = ur.resume_id
        WHERE ur.user_id = #{userId}
    </select>
</mapper>